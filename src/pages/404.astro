---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout title="404" description="404 Not Found">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-96 items-center justify-center">
        <div class="card-base z-10 px-9 py-16 relative w-full flex flex-col items-center justify-center text-center">
            <div class="text-[5rem] font-bold text-[var(--primary)] leading-none mb-4 select-none">
                404
            </div>
            <div class="text-xl font-bold text-90 mb-2">
                页面未找到 / Page Not Found
            </div>
            <p class="text-50 text-sm max-w-md mb-8">
                抱歉，您访问的页面不存在或已被移除。请检查输入的链接是否正确。
            </p>
            <a href={url("/")} class="btn-regular rounded-lg px-6 py-2.5 font-bold flex items-center gap-2 active:scale-95">
                <Icon name="fa6-solid:house" class="text-[0.95rem]"></Icon>
                <span>{i18n(I18nKey.home)}</span>
            </a>
        </div>
    </div>
</MainGridLayout>

